  "item": [
    {
      "name": "1 ลานทั้งหมด (US02)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const lots = pm.response.json();",
              "pm.test('8 ลาน เรียงตามรหัส', () => { pm.expect(lots.length).to.eql(8); pm.expect(lots[0].code).to.eql('M1'); });",
              "pm.test('ไม่ส่งจำนวนที่ว่าง', () => pm.expect(lots[0]).to.not.have.property('availableSpots'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/parking-lots",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "parking-lots"
          ]
        }
      }
    },
