@startuml
skinparam defaultFontName Tahoma
hide circle
title ER Diagram - ลานจอดรถ (Sprint 1)
entity "parking_lot\nลานจอดรถ" as parking_lot {
  * id : BIGINT <<PK, IDENTITY>>
  --
  * code : NVARCHAR(10) <<UNIQUE>>  -- รหัสลาน เช่น P1, M1
  * name_th : NVARCHAR(150)  -- ชื่อลาน
  building : NVARCHAR(150)  -- อาคารใกล้ลาน (ใช้ค้นหา)
  * vehicle_type : NVARCHAR(12)  -- CAR / MOTORCYCLE
  * latitude : DECIMAL(9,6)
  * longitude : DECIMAL(9,6)
  * total_spots : INT  -- > 0 (ใช้ใน Sprint 2)
  * available_spots : INT  -- 0..total_spots (ใช้ใน Sprint 2)
  * updated_at : DATETIME2
  zone : NVARCHAR(MAX)  -- เขตลาน JSON [[lat,lng],...]
}
@enduml
