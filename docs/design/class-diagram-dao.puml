@startuml
skinparam defaultFontName Tahoma
title Class Diagram - DAO
interface "JpaRepository<ParkingLot, Long>" as JPA

interface ParkingLotRepository {
  +findAllByOrderByCodeAsc() : List<ParkingLot>
  +search(keyword : String) : List<ParkingLot>
  +searchLike(keyword : String) : List<ParkingLot>
  +findByVehicleTypeOrderByCodeAsc(type : String) : List<ParkingLot>
}
note right of ParkingLotRepository
  search() กัน % _ [ ที่ผู้ใช้พิมพ์
  แล้วส่งต่อให้ searchLike() (@Query LIKE)
end note

class ParkingLot <<Entity>> {
  -id : Long
  -code : String
  -nameTh : String
  -building : String
  -vehicleType : String
  -latitude : BigDecimal
  -longitude : BigDecimal
  -totalSpots : int
  -availableSpots : int
  -zone : String
  -updatedAt : LocalDateTime
}

JPA <|-- ParkingLotRepository
ParkingLotRepository ..> ParkingLot : อ่านจากตาราง parking_lot
@enduml
