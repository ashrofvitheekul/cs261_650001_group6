@startuml
skinparam defaultFontName Tahoma
title US02 ดูลานจอดบนแผนที่
actor "ผู้ใช้" as U
participant "หน้าเว็บ\n(map.js)" as UI
participant ParkingLotController as C
participant ParkingLotService as S
participant ParkingLotRepository as R
database "MS SQL\nparking_lot" as DB
U -> UI : เปิด http://localhost:3000
UI -> C : GET /api/parking-lots
C -> S : findAll(null)
S -> R : findAllByOrderByCodeAsc()
R -> DB : SELECT ... ORDER BY code
DB --> R : 8 แถว
R --> S : List<ParkingLot>
S --> C : List<ParkingLotResponse>
C --> UI : 200 JSON
alt ไม่มีข้อมูล
  UI --> U : "ยังไม่มีข้อมูลลานจอด"
else มีข้อมูล
  UI --> U : หมุด + เขตลานบนแผนที่ และการ์ดรายการ (รหัส, ชื่อลาน)
end
@enduml
